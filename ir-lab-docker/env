# =============================================================================
# IR Lab — environment file
#
# docker compose auto-loads this file. It MUST be named ".env" and sit in the
# same folder as docker-compose.yml (i.e. inside ir-lab-docker/).
#
# These are the ONLY values the compose file reads from here. Every other
# setting (tool passwords, ports) is already baked into docker-compose.yml.
# =============================================================================

# The address users type in their browser to reach the tools.
# MISP and Mattermost bake this into the links/redirects/cookies they generate,
# so it MUST match how the lab is actually reached:
#
#   Local test VM     ->  localhost              (works as-is; no edit needed)
#   Google Cloud VM   ->  your static IP, e.g.   34.123.45.67
#
HOST_IP=localhost

# MISP image — leave as-is (this just spells out the default).
MISP_IMAGE=ghcr.io/nukib/misp:latest
